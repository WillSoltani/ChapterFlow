  "openerRegistry": {
    "gentle": {
      "ch01": "Horowitz begins the introduction by naming a gap that many leaders feel but rarely hear spoken plainly.",
      "ch02": "Horowitz uses Chapter 2 to answer a trust question before the book gets painful.",
      "ch03": "The chapter opens after the environment has already turned against Loudcloud.",
      "ch04": "Aria ends a painful week thinking the team finally has room to recover.",
      "ch08": "Chapter 8 begins in a pressure scene because uncertainty leadership fails or succeeds in moments like that, not in clean planning sessions.",
      "ch07": "Farah enters a Monday leadership meeting expecting a normal review, then watches three teams describe three different versions of the same quarter.",
      "ch05": "The calls start before sunrise and keep coming.",
      "ch10": "The handoff looks cleaner from a distance than it feels up close.",
      "ch09": "The chapter opens in the space where entrepreneurship sounds neat but behaves badly."
    },
    "direct": {
      "ch01": "The introduction opens with a structural contrast.",
      "ch02": "Chapter 2 establishes the source code for Horowitz's management logic.",
      "ch03": "Chapter 3 starts with a market regime change that invalidates standard startup assumptions.",
      "ch04": "Chapter 4 extends the survival arc by changing the unit of analysis from one crisis to recurring decision load.",
      "ch08": "Chapter 8 treats ambiguity as an operating condition, not a rare interruption.",
      "ch07": "Chapter 7 opens on a coordination failure, not a motivation failure.",
      "ch05": "This chapter treats collapse as operating reality, not drama.",
      "ch10": "Horowitz uses the ending to separate outcome from interpretation.",
      "ch09": "Horowitz's argument is not that entrepreneurship is random."
    },
    "competitive": {
      "ch01": "Horowitz uses the introduction to break a comfortable illusion.",
      "ch02": "Chapter 2 is where Horowitz earns the right to be blunt later.",
      "ch03": "The chapter begins where startup mythology breaks.",
      "ch04": "Chapter 4 is where leadership excuses run out.",
      "ch08": "Chapter 8 opens where leadership excuses die: hard deadline, incomplete facts, and a team deciding whether to trust the person in charge.",
      "ch07": "Chapter 7 begins where scaling myths fail.",
      "ch05": "The calls start before sunrise and keep coming.",
      "ch10": "The chapter strips away the flattering version of success.",
      "ch09": "The chapter goes after a familiar entrepreneurial lie: that the right rule can save the leader from the harder work of thinking."
    }
  },
