{ "Version": "2012-10-17", "Statement": [{
  "Effect": "Allow",
  "Principal": { "Federated": "arn:aws:iam::928413605677:oidc-provider/token.actions.githubusercontent.com" },
  "Action": "sts:AssumeRoleWithWebIdentity",
  "Condition": {
    "StringEquals": {
      "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
      "token.actions.githubusercontent.com:sub": [
        "repo:WillSoltani/ChapterFlow:environment:dev",
        "repo:WillSoltani/ChapterFlow:environment:staging",
        "repo:WillSoltani/ChapterFlow:environment:prod"
      ]
    }
  }
}]}
