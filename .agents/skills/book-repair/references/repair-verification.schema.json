{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapterflow.local/schemas/repair-verification-1.0.0.json",
  "title": "ChapterFlow repair verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "blind_raters",
    "verification_provenance",
    "conditions",
    "mapped_defects",
    "new_defects",
    "unresolved_defects",
    "pipeline",
    "report_mirror"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "blind_raters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_path", "primary_sha256", "verification_path", "verification_sha256", "primary_dispatch_path", "primary_dispatch_sha256", "verification_dispatch_path", "verification_dispatch_sha256", "blind_pair_seal_path", "blind_pair_seal_sha256"],
      "properties": {
        "primary_path": {"type": "string", "minLength": 1},
        "primary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verification_path": {"type": "string", "minLength": 1},
        "verification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "primary_dispatch_path": {"type": "string", "minLength": 1},
        "primary_dispatch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verification_dispatch_path": {"type": "string", "minLength": 1},
        "verification_dispatch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blind_pair_seal_path": {"type": "string", "minLength": 1},
        "blind_pair_seal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "verification_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_thread_id",
        "evaluator_project_id",
        "evaluator_task_forked",
        "book_update_path",
        "book_update_sha256",
        "adjudication_path",
        "adjudication_sha256",
        "evaluated_after_repair",
        "blind_result_sealed_before_baseline_opened"
      ],
      "properties": {
        "evaluator_thread_id": {"type": "string", "minLength": 1},
        "evaluator_project_id": {"type": "string", "minLength": 1},
        "evaluator_task_forked": {"const": false},
        "book_update_path": {"type": "string", "minLength": 1},
        "book_update_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "adjudication_path": {"type": "string", "minLength": 1},
        "adjudication_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evaluated_after_repair": {"const": true},
        "blind_result_sealed_before_baseline_opened": {"const": true}
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "canonical_rubric_path", "post_repair_percent", "adjudication_evidence", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:O-001|D-[0-9]{2}|S-[0-9]{2}-[0-9]{2})$"},
          "status": {"enum": ["fixed", "confirmed_fixed"]},
          "canonical_rubric_path": {"type": "string", "minLength": 1},
          "post_repair_percent": {"type": "number", "minimum": 80},
          "adjudication_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "object"}
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator", "finding"],
              "properties": {
                "locator": {"type": "string", "minLength": 1},
                "finding": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "mapped_defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^(?:G-[A-Z-]+|Q-[A-F0-9]{12})$"},
          "status": {"enum": ["fixed", "confirmed_fixed", "confirmed_not_present"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["locator", "finding"],
              "properties": {
                "locator": {"type": "string", "minLength": 1},
                "finding": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "new_defects": {
      "type": "array",
      "maxItems": 0
    },
    "unresolved_defects": {
      "type": "array",
      "maxItems": 0
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_gate", "major_status", "qc_converge", "fresh_qc"],
      "properties": {
        "book_gate": {"const": "Pass"},
        "major_status": {"const": "Pass"},
        "qc_converge": {"const": "DETERMINISTIC-CLEAN"},
        "fresh_qc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score", "minimum_axis", "after_last_content_change", "session_independent", "round_id", "evidence_matrix_path", "evidence_matrix_sha256"],
          "properties": {
            "status": {"const": "Pass"},
            "score": {"type": "number", "minimum": 85},
            "minimum_axis": {"type": "number", "minimum": 0.6},
            "after_last_content_change": {"const": true},
            "session_independent": {"const": true},
            "round_id": {"type": "string", "minLength": 1},
            "evidence_matrix_path": {"type": "string", "minLength": 1},
            "evidence_matrix_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "report_mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transactional", "validated_before_mirror", "repo_snapshot_dir", "updater_receipt_path", "updater_receipt_sha256"],
      "properties": {
        "transactional": {"const": true},
        "validated_before_mirror": {"const": true},
        "repo_snapshot_dir": {"type": "string", "minLength": 1},
        "updater_receipt_path": {"type": "string", "minLength": 1},
        "updater_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
