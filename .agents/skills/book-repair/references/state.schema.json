{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapterflow.local/schemas/book-repair-state-1.0.0.json",
  "title": "Book repair run state",
  "type": "object",
  "required": ["schema_version", "run_id", "book_id", "phase", "context_path", "context_sha256", "context_seal_path", "context_seal_sha256", "context_seal_git_ref", "context_seal_git_oid", "context_seal_blob_oid", "repair_prompt_path", "repair_prompt_sha256", "authorizations", "history"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "book_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "context_path": {"type": "string", "minLength": 1},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_seal_path": {"type": "string", "minLength": 1},
    "context_seal_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_seal_git_ref": {"type": "string", "pattern": "^refs/chapterflow/book-repair-seals/"},
    "context_seal_git_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "context_seal_blob_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "repair_prompt_path": {"type": "string", "minLength": 1},
    "repair_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "phase": {
      "enum": [
        "context_loaded",
        "repairing",
        "repair_complete",
        "fresh_qc_passed",
        "evaluator_thread_created",
        "evaluation_complete",
        "report_updated",
        "acceptance_passed",
        "acceptance_failed",
        "published"
      ]
    },
    "authorizations": {
      "type": "object",
      "required": ["new_evaluator_thread", "git_push"],
      "properties": {
        "new_evaluator_thread": {"type": "boolean"},
        "git_push": {"type": "boolean"}
      }
    },
    "history": {"type": "array", "minItems": 1}
  }
}
