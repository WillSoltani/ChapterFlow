{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapterflow.local/schemas/book-evaluation.schema.json",
  "title": "ChapterFlow Independent Full-Content Book Evaluation v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "job_id",
    "rater_role",
    "source_hash",
    "worker_dispatch_receipt_sha256",
    "book",
    "technical_findings",
    "gates",
    "chapter_evidence",
    "domains",
    "overall_score",
    "classification",
    "certification_status",
    "analysis",
    "qa"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "rater_role": {"enum": ["primary", "verification"]},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "worker_dispatch_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "book": {"$ref": "#/$defs/book"},
    "technical_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/technicalFinding"}
    },
    "gates": {"$ref": "#/$defs/gates"},
    "chapter_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/chapterEvidence"}
    },
    "domains": {"$ref": "#/$defs/domainsInteger"},
    "overall_score": {"type": "number", "minimum": 0, "maximum": 100},
    "classification": {"$ref": "#/$defs/classification"},
    "certification_status": {"enum": ["pass", "conditional", "fail", "unevaluable"]},
    "analysis": {"$ref": "#/$defs/analysis"},
    "qa": {"$ref": "#/$defs/qa"}
  },
  "$defs": {
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_path", "chapter", "section", "item_id", "paraphrase"],
      "properties": {
        "package_path": {"type": "string", "minLength": 1},
        "chapter": {"type": "string", "minLength": 1},
        "section": {"$ref": "#/$defs/nullableString"},
        "item_id": {"$ref": "#/$defs/nullableString"},
        "paraphrase": {"type": "string", "minLength": 1}
      }
    },
    "evidenceArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "componentInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["examples", "quiz_questions", "review_cards", "implementation_items", "exercises", "memorable_lines", "other"],
      "properties": {
        "examples": {"$ref": "#/$defs/nonNegativeInteger"},
        "quiz_questions": {"$ref": "#/$defs/nonNegativeInteger"},
        "review_cards": {"$ref": "#/$defs/nonNegativeInteger"},
        "implementation_items": {"$ref": "#/$defs/nonNegativeInteger"},
        "exercises": {"$ref": "#/$defs/nonNegativeInteger"},
        "memorable_lines": {"$ref": "#/$defs/nonNegativeInteger"},
        "other": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/nonNegativeInteger"}
        }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "book_id",
        "slug",
        "title",
        "subtitle",
        "package_path",
        "package_format",
        "nonfiction_type",
        "declared_or_inferred_audience",
        "assumed_prior_knowledge",
        "declared_or_inferred_purpose",
        "intended_outcomes",
        "contexts_and_exclusions",
        "chapter_count_expected",
        "chapter_count_read_full",
        "chapter_count_partial",
        "chapter_count_inaccessible",
        "all_accessible_chapters_read",
        "word_count_estimate",
        "component_inventory"
      ],
      "properties": {
        "book_id": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"$ref": "#/$defs/nullableString"},
        "package_path": {"type": "string", "minLength": 1},
        "package_format": {"type": "string", "minLength": 1},
        "nonfiction_type": {"type": "string", "minLength": 1},
        "declared_or_inferred_audience": {"type": "string", "minLength": 1},
        "assumed_prior_knowledge": {"type": "string", "minLength": 1},
        "declared_or_inferred_purpose": {"type": "string", "minLength": 1},
        "intended_outcomes": {"$ref": "#/$defs/stringArray"},
        "contexts_and_exclusions": {"$ref": "#/$defs/stringArray"},
        "chapter_count_expected": {"$ref": "#/$defs/nonNegativeInteger"},
        "chapter_count_read_full": {"$ref": "#/$defs/nonNegativeInteger"},
        "chapter_count_partial": {"const": 0},
        "chapter_count_inaccessible": {"const": 0},
        "all_accessible_chapters_read": {"const": true},
        "word_count_estimate": {"$ref": "#/$defs/nonNegativeInteger"},
        "component_inventory": {"$ref": "#/$defs/componentInventory"}
      }
    },
    "technicalFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "type", "locator", "description", "reader_facing", "scoring_treatment"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "type": {"enum": ["missing", "duplicate", "malformed", "inaccessible", "ambiguous", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "reader_facing": {"type": "boolean"},
        "scoring_treatment": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "conditional", "fail", "not_assessed", "unevaluable"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceArray"}
      }
    },
    "externalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "evidence"],
      "properties": {
        "status": {"const": "not_assessed"},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceArray"}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_completeness", "epistemic_instructional_safety", "ethics_reader_autonomy", "purpose_audience_declaration", "external_accuracy"],
      "properties": {
        "technical_completeness": {"$ref": "#/$defs/gate"},
        "epistemic_instructional_safety": {"$ref": "#/$defs/gate"},
        "ethics_reader_autonomy": {"$ref": "#/$defs/gate"},
        "purpose_audience_declaration": {"$ref": "#/$defs/gate"},
        "external_accuracy": {"$ref": "#/$defs/externalGate"}
      }
    },
    "chapterEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_index", "chapter_id", "title", "read_status", "central_ideas", "mental_model_contribution", "engagement_and_pacing", "learning_support", "retention_support", "transfer_support", "trust_qa_safety_issues", "evidence"],
      "properties": {
        "chapter_index": {"type": "integer", "minimum": 1},
        "chapter_id": {"$ref": "#/$defs/nullableString"},
        "title": {"type": "string", "minLength": 1},
        "read_status": {"const": "full"},
        "central_ideas": {"$ref": "#/$defs/stringArray"},
        "mental_model_contribution": {"type": "string"},
        "engagement_and_pacing": {"type": "string"},
        "learning_support": {"type": "string"},
        "retention_support": {"type": "string"},
        "transfer_support": {"type": "string"},
        "trust_qa_safety_issues": {"$ref": "#/$defs/stringArray"},
        "evidence": {"$ref": "#/$defs/evidenceArray"}
      }
    },
    "integerRatingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "rationale", "strength_evidence", "limitation_evidence"],
      "properties": {
        "rating": {"type": "integer", "minimum": 0, "maximum": 4},
        "rationale": {"type": "string", "minLength": 1},
        "strength_evidence": {"$ref": "#/$defs/evidenceArray"},
        "limitation_evidence": {"$ref": "#/$defs/evidenceArray"}
      }
    },
    "domainBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weight", "subcriteria", "whole_book_pattern", "domain_score", "weighted_points"],
      "properties": {
        "weight": {"type": "number"},
        "subcriteria": {"type": "object"},
        "whole_book_pattern": {"type": "string", "minLength": 1},
        "domain_score": {"type": "number", "minimum": 0, "maximum": 4},
        "weighted_points": {"type": "number", "minimum": 0, "maximum": 15}
      }
    },
    "epistemicSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_support_fit", "uncertainty_limitations", "internal_consistency_qa", "misuse_safeguards"],
      "properties": {
        "claim_support_fit": {"$ref": "#/$defs/integerRatingRecord"},
        "uncertainty_limitations": {"$ref": "#/$defs/integerRatingRecord"},
        "internal_consistency_qa": {"$ref": "#/$defs/integerRatingRecord"},
        "misuse_safeguards": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "audienceSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["language_clarity", "beginner_onboarding", "signal_noise_framework_load", "audience_context_accessibility"],
      "properties": {
        "language_clarity": {"$ref": "#/$defs/integerRatingRecord"},
        "beginner_onboarding": {"$ref": "#/$defs/integerRatingRecord"},
        "signal_noise_framework_load": {"$ref": "#/$defs/integerRatingRecord"},
        "audience_context_accessibility": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "mentalModelSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["central_model", "mechanism_causal_explanation", "cross_concept_integration", "nuance_diagnostic_power"],
      "properties": {
        "central_model": {"$ref": "#/$defs/integerRatingRecord"},
        "mechanism_causal_explanation": {"$ref": "#/$defs/integerRatingRecord"},
        "cross_concept_integration": {"$ref": "#/$defs/integerRatingRecord"},
        "nuance_diagnostic_power": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "learningSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["sequencing_scaffolding", "worked_examples_contrasts", "active_processing", "feedback_metacognitive_calibration"],
      "properties": {
        "sequencing_scaffolding": {"$ref": "#/$defs/integerRatingRecord"},
        "worked_examples_contrasts": {"$ref": "#/$defs/integerRatingRecord"},
        "active_processing": {"$ref": "#/$defs/integerRatingRecord"},
        "feedback_metacognitive_calibration": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "retentionSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["meaningful_retrieval_cues", "cumulative_reinforcement", "quiz_retrieval_depth", "interference_control_consolidation"],
      "properties": {
        "meaningful_retrieval_cues": {"$ref": "#/$defs/integerRatingRecord"},
        "cumulative_reinforcement": {"$ref": "#/$defs/integerRatingRecord"},
        "quiz_retrieval_depth": {"$ref": "#/$defs/integerRatingRecord"},
        "interference_control_consolidation": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "transferSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["concrete_actions", "cross_context_transfer", "implementation_feedback_support", "boundaries_adaptation_tradeoffs"],
      "properties": {
        "concrete_actions": {"$ref": "#/$defs/integerRatingRecord"},
        "cross_context_transfer": {"$ref": "#/$defs/integerRatingRecord"},
        "implementation_feedback_support": {"$ref": "#/$defs/integerRatingRecord"},
        "boundaries_adaptation_tradeoffs": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "motivationSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["personal_relevance", "achievable_progress", "autonomy_non_shaming_tone", "calibrated_confidence"],
      "properties": {
        "personal_relevance": {"$ref": "#/$defs/integerRatingRecord"},
        "achievable_progress": {"$ref": "#/$defs/integerRatingRecord"},
        "autonomy_non_shaming_tone": {"$ref": "#/$defs/integerRatingRecord"},
        "calibrated_confidence": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "engagementSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["curiosity_momentum", "narrative_example_vividness", "emotional_relevance", "instructional_alignment"],
      "properties": {
        "curiosity_momentum": {"$ref": "#/$defs/integerRatingRecord"},
        "narrative_example_vividness": {"$ref": "#/$defs/integerRatingRecord"},
        "emotional_relevance": {"$ref": "#/$defs/integerRatingRecord"},
        "instructional_alignment": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "wholeBookSubcriteriaInteger": {
      "type": "object", "additionalProperties": false,
      "required": ["chapter_necessity_order", "quality_consistency_pacing", "redundancy_cumulative_load", "synthesis_completion_value"],
      "properties": {
        "chapter_necessity_order": {"$ref": "#/$defs/integerRatingRecord"},
        "quality_consistency_pacing": {"$ref": "#/$defs/integerRatingRecord"},
        "redundancy_cumulative_load": {"$ref": "#/$defs/integerRatingRecord"},
        "synthesis_completion_value": {"$ref": "#/$defs/integerRatingRecord"}
      }
    },
    "domainsInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epistemic_integrity", "audience_fit", "mental_model_coherence", "learning_architecture", "retention_retrieval", "transfer_action_judgment", "motivation_autonomy", "engagement_momentum", "whole_book_coherence"],
      "properties": {
        "epistemic_integrity": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 15}, "subcriteria": {"$ref": "#/$defs/epistemicSubcriteriaInteger"}}}]},
        "audience_fit": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 12}, "subcriteria": {"$ref": "#/$defs/audienceSubcriteriaInteger"}}}]},
        "mental_model_coherence": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 15}, "subcriteria": {"$ref": "#/$defs/mentalModelSubcriteriaInteger"}}}]},
        "learning_architecture": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 12}, "subcriteria": {"$ref": "#/$defs/learningSubcriteriaInteger"}}}]},
        "retention_retrieval": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 10}, "subcriteria": {"$ref": "#/$defs/retentionSubcriteriaInteger"}}}]},
        "transfer_action_judgment": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 15}, "subcriteria": {"$ref": "#/$defs/transferSubcriteriaInteger"}}}]},
        "motivation_autonomy": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 8}, "subcriteria": {"$ref": "#/$defs/motivationSubcriteriaInteger"}}}]},
        "engagement_momentum": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 8}, "subcriteria": {"$ref": "#/$defs/engagementSubcriteriaInteger"}}}]},
        "whole_book_coherence": {"allOf": [{"$ref": "#/$defs/domainBase"}, {"properties": {"weight": {"const": 5}, "subcriteria": {"$ref": "#/$defs/wholeBookSubcriteriaInteger"}}}]}
      }
    },
    "classification": {
      "enum": [
        "Reference-standard design, subject to gate and core-domain rules",
        "Strong design with identifiable improvements",
        "Valuable but materially uneven; targeted redesign needed",
        "Substantial redesign needed",
        "Not ready as a ChapterFlow learning product",
        "Unevaluable"
      ]
    },
    "engagementCurveItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapter_range", "direction", "explanation"],
      "properties": {
        "chapter_range": {"type": "string", "minLength": 1},
        "direction": {"enum": ["rises", "steady", "falls", "mixed"]},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_reader_experience", "strongest_qualities", "weakest_qualities", "engagement_curve", "comprehension_and_retention_support", "practical_use_and_judgment", "best_fit_reader", "readers_who_may_struggle", "highest_impact_improvements", "final_verdict"],
      "properties": {
        "overall_reader_experience": {"type": "string", "minLength": 1},
        "strongest_qualities": {"$ref": "#/$defs/stringArray"},
        "weakest_qualities": {"$ref": "#/$defs/stringArray"},
        "engagement_curve": {"type": "array", "items": {"$ref": "#/$defs/engagementCurveItem"}},
        "comprehension_and_retention_support": {"type": "string", "minLength": 1},
        "practical_use_and_judgment": {"type": "string", "minLength": 1},
        "best_fit_reader": {"type": "string", "minLength": 1},
        "readers_who_may_struggle": {"type": "string", "minLength": 1},
        "highest_impact_improvements": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "final_verdict": {"type": "string", "minLength": 1}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_36_subcriteria_present", "evidence_minimums_pass", "calculation_check_pass", "semantic_quiz_issues", "formulaic_pattern_notes", "unsupported_outcome_claims_found", "self_validation_notes"],
      "properties": {
        "all_36_subcriteria_present": {"const": true},
        "evidence_minimums_pass": {"const": true},
        "calculation_check_pass": {"const": true},
        "semantic_quiz_issues": {"$ref": "#/$defs/stringArray"},
        "formulaic_pattern_notes": {"$ref": "#/$defs/stringArray"},
        "unsupported_outcome_claims_found": {"const": false},
        "self_validation_notes": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
