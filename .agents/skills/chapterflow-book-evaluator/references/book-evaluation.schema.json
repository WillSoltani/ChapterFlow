              ]
            },
            "subcriteria": {
              "$ref": "#/$defs/transferSubcriteriaInteger"
            },
            "whole_book_pattern": {
              "type": "string"
            },
            "domain_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "weighted_points": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "motivation_autonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
