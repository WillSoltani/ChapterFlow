                15
              ]
            },
            "subcriteria": {
              "$ref": "#/$defs/mentalModelSubcriteriaInteger"
            },
            "whole_book_pattern": {
              "type": "string"
            },
            "domain_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "weighted_points": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "learning_architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "weight",
            "subcriteria",
            "whole_book_pattern",
            "domain_score",
            "weighted_points"
          ],
          "properties": {
            "weight": {
              "type": "integer",
              "enum": [
                12
              ]
            },
            "subcriteria": {
              "$ref": "#/$defs/learningSubcriteriaInteger"
            },
            "whole_book_pattern": {
              "type": "string"
            },
            "domain_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "weighted_points": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "retention_retrieval": {
          "type": "object",
          "additionalProperties": false,
