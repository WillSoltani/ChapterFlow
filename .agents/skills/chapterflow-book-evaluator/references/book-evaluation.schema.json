              "type": "integer",
              "enum": [
                12
              ]
            },
            "subcriteria": {
              "$ref": "#/$defs/audienceSubcriteriaInteger"
            },
            "whole_book_pattern": {
              "type": "string"
            },
            "domain_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "weighted_points": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "mental_model_coherence": {
