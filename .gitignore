# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CDK build artifacts — never commit generated output
infra/cdk.out/
infra/.cache/

# Infra dependencies — installed locally, not versioned
infra/node_modules/

# Subpackage node_modules (lambda workers, etc.)
infra/lib/lambdas/*/node_modules/
node_modules/
.next/
.next-chapterflow/
.next-chapterflow-bookcheck/
.open-next/

# CDK build artifacts — compiled TS output from infra/tsconfig.json
infra/dist/

# Editor swap/backup cruft (never commit — these can leak file contents)
*.swp
*.swo
*~

# Claude Code local working state — worktrees, agent cache, todos, MCP config
.claude/

# ChapterFlow v21 pipeline working tree — generation scratch (runs/), source
# texts (sources/), and logs. NOT part of the web-app product; only scripts/book/**
# reads it, and that runs locally. Kept on disk, never tracked. (History still
# contains the old copies — purge via git filter-repo + force-push to fully remove.)
/.chapterflow/

# ChapterFlow v21 pipeline state (durability hygiene — Phase 0).
# Chapters + indexes ARE the product of Step-2 work and MUST stay tracked
# (do NOT ignore state/chapters/*.chapter.json). Only the derived/churny and
# accidental-shadow paths are excluded:
/state/                                                                   # repo-root SHADOW state dir — forbidden (gates read the pipeline copy)
scripts/book/prompts/chapterflow-v21-authored/state/gate-attempts.json    # machine churn, rewritten every gate run
scripts/book/prompts/chapterflow-v21-authored/state/gate-verdicts/        # derived verdict sidecars (later phases)
scripts/book/prompts/chapterflow-v21-authored/state/chapters/.backup-*/   # ad-hoc backup snapshots — use git, not dirs
scripts/book/prompts/chapterflow-v21-authored/scratch/_shadow-drive-backup-*/  # Phase-0 migration backup

# Playwright E2E
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
