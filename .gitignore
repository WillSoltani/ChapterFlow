# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/coverage-text.txt
/.nyc_output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …the committed values-free template is the one exception:
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CDK build artifacts — never commit generated output
infra/cdk.out/
infra/.cache/
# Account-bound lookup caches and generated IAM outputs are local artifacts.
infra/cdk.context.json
infra/iam/generated/

# Infra dependencies — installed locally, not versioned
infra/node_modules/

# Subpackage node_modules (lambda workers, etc.)
infra/lib/lambdas/*/node_modules/
node_modules/
.next/
.next-*/
.next-chapterflow/
.next-chapterflow-bookcheck/
.next-cf-dev/
.open-next/

# CDK build artifacts — compiled TS output from infra/tsconfig.json
infra/dist/

# Editor swap/backup cruft (never commit — these can leak file contents)
*.swp
*.swo
*~

# Claude Code local working state — worktrees, agent cache, todos, MCP config
.claude/

# ChapterFlow v21 pipeline working tree — generation scratch (runs/), source
# texts (sources/), and logs. NOT part of the web-app product; only scripts/book/**
# reads it, and that runs locally. Kept on disk, never tracked. (History still
# contains the old copies — purge via git filter-repo + force-push to fully remove.)
/.chapterflow/
# pipeline runtime dir: source-verify records + workbench, qc-orchestrator rounds — transient, never tracked
scripts/book/prompts/chapterflow-v21-authored/.chapterflow/

# ChapterFlow v21 pipeline state (durability hygiene — Phase 0).
# Chapters + indexes ARE the product of Step-2 work and MUST stay tracked
# (do NOT ignore state/chapters/*.chapter.json). Only the derived/churny and
# accidental-shadow paths are excluded:
# NOTE: gitignore treats `#` as a comment ONLY at the start of a line. Keep each
# comment on its OWN line — a trailing `pattern  # note` makes the note part of the
# pattern, so it silently matches nothing (that bug left gate-attempts.json tracked
# and churning every gate run).
# repo-root SHADOW state dir — forbidden (gates read the pipeline copy)
/state/
# machine churn, rewritten every gate run
scripts/book/prompts/chapterflow-v21-authored/state/gate-attempts.json
# append-only quality telemetry — local accrual, not durable product state
scripts/book/prompts/chapterflow-v21-authored/state/metrics/
# derived verdict sidecars (later phases)
scripts/book/prompts/chapterflow-v21-authored/state/gate-verdicts/
# ad-hoc backup snapshots — use git, not dirs
scripts/book/prompts/chapterflow-v21-authored/state/chapters/.backup-*/
# Phase-0 migration backup
scripts/book/prompts/chapterflow-v21-authored/scratch/_shadow-drive-backup-*/

# Per-round cross-chapter sweep history — a best-effort, machine-LOCAL optimization that backs the
# sticky-gate corroboration + item-B two-read confirmation. checkSweep is fail-safe without it (no
# history ⇒ gate stands, exactly the pre-history behavior), so it must not be committed (high churn,
# and reproducibility in CI/fresh checkout is preserved by the fail-safe).
scripts/book/prompts/chapterflow-v21-authored/state/qc/*.sweep-history.jsonl

# Playwright E2E
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ChapterFlow 140-book evaluation snapshot. The current snapshot is force-added;
# subsequent untracked generated files in this directory remain local.
/docs/v25/chapterflow-140-evaluation/
