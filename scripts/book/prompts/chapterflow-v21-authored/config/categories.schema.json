{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "categories.schema.json",
  "title": "ChapterFlow Categories",
  "type": "object",
  "required": ["version", "canonical", "aliases"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "canonical": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": false
}
