  "governance": {
    "definitionsFrozenBeforeLiveOutput": true,
    "calibrationVsHoldoutSeparated": true,
    "holdoutImmutableOnceLiveQualificationBegins": true,
    "noInCampaignInstrumentTreadmill": "a material instrument defect terminates the experiment id and starts a NEW id",
    "independentHumanRater": false,
    "sourceCleanStatusNeverInferredFromOverallScore": true,
    "sourceSemanticsNeverInferred": "if source semantics are absent, record sourceSemanticsStatus:MISSING and EXCLUDE from clean gold — never synthesize a planSpec/format (E-04)"
  },
