{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IMP-24 SourceIntegrityModelOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessments"],
  "properties": {
    "schema": { "type": "string", "enum": ["source-integrity-model-output-v2"] },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assessment" }
    }
  },
  "$defs": {
    "category": {
      "type": "string",
      "enum": [
        "source_contradiction",
        "unsupported_attribution",
        "claim_strength_overreach",
        "missing_visible_framing",
        "generic_specificity_leak",
        "invented_detail",
        "missing_required_evidence"
      ]
    },
    "nonEmptyRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "possiblyEmptyRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryCategory",
        "secondaryCategories",
        "severity",
        "explanation",
        "chapterEvidenceRefIds",
        "sourceEvidenceRefIds"
      ],
      "properties": {
        "primaryCategory": { "$ref": "#/$defs/category" },
        "secondaryCategories": {
          "type": "array",
          "items": { "$ref": "#/$defs/category" }
        },
        "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
        "explanation": { "type": "string" },
        "chapterEvidenceRefIds": { "$ref": "#/$defs/nonEmptyRefs" },
        "sourceEvidenceRefIds": { "$ref": "#/$defs/possiblyEmptyRefs" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRef",
        "visibleRegister",
        "supportStatus",
        "framingAdequate",
        "claimStrengthFit",
        "namedSpecificityAllowed",
        "findings",
        "rationale"
      ],
      "properties": {
        "targetRef": { "type": "string" },
        "visibleRegister": { "type": "string", "enum": ["clearly_sourced", "clearly_constructed", "clearly_generic", "ambiguous", "presented_as_fact"] },
        "supportStatus": { "type": "string", "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "NOT_APPLICABLE", "INCONCLUSIVE"] },
        "framingAdequate": { "type": ["boolean", "null"] },
        "claimStrengthFit": { "type": ["boolean", "null"] },
        "namedSpecificityAllowed": { "type": ["boolean", "null"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "rationale": { "type": "string" }
      }
    }
  }
}
