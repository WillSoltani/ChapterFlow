{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SplitLane ReaderExperienceReviewV1 (model output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scores",
    "quizDerivation",
    "recommendation",
    "blockingFindings",
    "escalationSignals",
    "advisoryFindings",
    "strongestEvidence",
    "weakestEvidence",
    "oneParagraphVerdict"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "reader-experience-review-v1"
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "quizzes",
        "transfer",
        "practical",
        "summaries",
        "tone",
        "limits",
        "insight",
        "density",
        "beginner"
      ],
      "properties": {
        "retention": { "type": "number" },
        "quizzes": { "type": "number" },
        "transfer": { "type": "number" },
        "practical": { "type": "number" },
        "summaries": { "type": "number" },
        "tone": { "type": "number" },
        "limits": { "type": "number" },
        "insight": { "type": "number" },
        "density": { "type": "number" },
        "beginner": { "type": "number" }
      }
    },
    "quizDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answers",
        "mechanisms",
        "confidence",
        "ambiguities",
        "tells"
      ],
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "c"
            ]
          }
        },
        "mechanisms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "ambiguities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tells": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "SHIP",
        "REVISE",
        "BLOCK"
      ]
    },
    "blockingFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "unit",
          "problem",
          "evidenceSpans"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "unsafe",
              "internal_contradiction",
              "structurally_invalid",
              "schema_or_app_breaking",
              "unusable"
            ]
          },
          "unit": { "type": "string" },
          "problem": { "type": "string" },
          "evidenceSpans": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "escalationSignals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "unit",
          "problem",
          "evidenceSpans"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "origin_ambiguous_to_reader",
              "possible_real_world_claim",
              "possible_attribution_issue"
            ]
          },
          "unit": { "type": "string" },
          "problem": { "type": "string" },
          "evidenceSpans": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "advisoryFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "unit",
          "problem",
          "evidenceSpans"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "thin_example",
              "quiz_cue",
              "repetition",
              "tone",
              "density",
              "pacing",
              "other_craft"
            ]
          },
          "unit": { "type": "string" },
          "problem": { "type": "string" },
          "evidenceSpans": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "strongestEvidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "weakestEvidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "oneParagraphVerdict": { "type": "string" }
  }
}
