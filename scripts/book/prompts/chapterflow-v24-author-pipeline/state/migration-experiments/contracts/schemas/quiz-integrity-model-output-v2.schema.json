{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IMP-24 QuizIntegrityModelOutputV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": { "type": "string", "enum": ["quiz-integrity-model-output-v2"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionRef", "keyCorrect", "defensibleAnswerIndices", "keyedMechanismSupported", "rationale", "evidenceRefIds"],
        "properties": {
          "questionRef": { "type": "string" },
          "keyCorrect": { "type": "string", "enum": ["correct", "ambiguous", "wrong"] },
          "defensibleAnswerIndices": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "keyedMechanismSupported": { "type": "boolean" },
          "rationale": { "type": "string" },
          "evidenceRefIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
