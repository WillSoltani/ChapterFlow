{
  "schema": "split-lane-corpus-mutation-spec-v1",
  "role": "reader",
  "corpusId": "s16-split-lane-reader-corpus-v1",
  "_note": "Committed, hermetic mutation spec for the reader-experience role corpus (H1). Replaces the ephemeral /private/tmp spec of E-09: it is in-repo and versioned, so a builder never silently drops variants. A builder MUST fail closed if this file is missing (never treat missing as []), and MUST fail closed rather than shrink below expectedComposition. All paths here are RELATIVE to this directory or are bookIds resolved against an INJECTED bookPackagesDir (no absolute /Users or temp paths, and never a canonical pipeline state-dir literal).",
  "governance": {
    "definitionsFrozenBeforeLiveOutput": true,
    "calibrationVsHoldoutSeparated": true,
    "holdoutImmutableOnceLiveQualificationBegins": true,
    "noInCampaignInstrumentTreadmill": "a material instrument defect terminates the experiment id and starts a NEW id; no in-campaign v3/v4 re-scoring",
    "independentHumanRater": false,
    "cleanStatusNeverInferredFromOverallScore": true
  },
  "cleanBaseScoreLedger": "clean-base-score-ledger.v1.json",
  "minRenderBytes": 8000,
  "basePool": [
    "difficult-conversations",
    "the-willpower-instinct",
    "the-power-of-moments",
    "decisive",
    "behave",
    "peak",
    "make-it-stick",
    "the-checklist-manifesto"
  ],
  "expectedComposition": {
    "clean": 12,
    "reader-visible-hard-blocker": 8,
    "craft-nonblocker": 10,
    "total": 30
  },
  "softDenominators": {
    "minCleanPassRate": 12,
    "minNonBlockerCalibrationRate": 10,
    "note": "each soft denominator >= 10 (E-07 fix); the 8 hard-blocker cases feed the 1.0 minHardBlockerSensitivity bar, which is exempt from the soft minimum-denominator rule"
  },
  "variantShape": "{ variantKey, baseBookId, baseChapter, kind, targetUnit?, ops:[{path,op,value}], expected, goldRationale, builderGenerated?, ownerAuthoredOps? }. op in {append,replace}; path is a JSON pointer into the ChapterV21 base. kind 'clean' has ops:[] (unmutated base). kind 'craft-nonblocker' is builderGenerated (a benign generic append the builder mints deterministically from appendText). kind 'reader-visible-hard-blocker' is ownerAuthoredOps (the reader-visible blocker prose is owner-authored gold, never fabricated here); the builder fails closed until ops are supplied.",
  "readerBlockerCategories": [
    "unsafe",
    "internal_contradiction",
    "structurally_invalid",
    "schema_or_app_breaking",
    "unusable"
  ],
  "readerBlockerCategoriesExcluded": {
    "excluded": ["fabricated", "factually_wrong", "source_contradictory"],
    "reason": "external source-truth is NOT reader-visible; those move to the source-integrity lane. Internal contradiction stays a reader blocker (on-page decidable)."
  },
