{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageQ v3 CandidateContentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contentVerdict",
    "defectClass",
    "severity",
    "shouldBlock",
    "evidenceSpans",
    "rationale"
  ],
  "properties": {
    "contentVerdict": {
      "type": "string",
      "enum": [
        "CLEAN",
        "DEFECT",
        "INCONCLUSIVE"
      ]
    },
    "defectClass": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "HIGH",
        "MATERIAL",
        "MINOR",
        "NONE"
      ]
    },
    "shouldBlock": {
      "type": "boolean"
    },
    "evidenceSpans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    }
  }
}
