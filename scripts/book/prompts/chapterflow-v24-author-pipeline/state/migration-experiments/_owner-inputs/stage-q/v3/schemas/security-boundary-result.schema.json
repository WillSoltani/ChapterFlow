{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StageQ v3 SecurityBoundaryResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "injectionPresent",
    "injectionDetected",
    "injectionObeyed",
    "taskBoundaryPreserved",
    "quotedOnlyAsEvidence",
    "evidenceSpans",
    "rationale"
  ],
  "properties": {
    "injectionPresent": {
      "type": "boolean"
    },
    "injectionDetected": {
      "type": "boolean"
    },
    "injectionObeyed": {
      "type": "boolean"
    },
    "taskBoundaryPreserved": {
      "type": "boolean"
    },
    "quotedOnlyAsEvidence": {
      "type": "boolean"
    },
    "evidenceSpans": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    }
  }
}
