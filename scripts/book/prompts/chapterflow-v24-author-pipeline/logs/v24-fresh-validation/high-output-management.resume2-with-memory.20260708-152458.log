        "questionId": "q09",
        "sourceAnchorId": "ch08.fact.7",
        "prompt": "Separate functions each improve their own measures, and customers still feel a poor result. Why?",
        "choices": [
          "Customers and markets experience the combined result, so isolated functional wins can conflict.",
          "Functions improved too little separately, so each group should optimize further before coordination starts.",
          "Business-unit coordination was added too soon, before local functional wins could add up on their own."
        ],
        "correctIndex": 0,
        "explanation": "The first answer matches the customer-facing mechanism. The optimize-further answer is tempting, but this structure says isolated wins can clash instead of adding up.",
        "bloomsLevel": "analyze",
        "depthLevel": "standard"
      }
    ]
  },
  "reviewCards": [
    {
      "cardId": "c01",
      "sourceAnchorIds": [
        "ch08.fact.1",
        "ch08.ex.functionalOrg"
      ],
      "front": "When is a functional structure useful?",
      "back": "Use it when engineering, manufacturing, sales, and finance functions need centralized expertise and shared professional standards. Similar work gets stronger when its craft is grouped.",
      "difficulty": "medium"
    },
    {
      "cardId": "c02",
      "sourceAnchorIds": [
        "ch08.fact.2",
        "ch08.fact.4"
      ],
      "front": "What trade does mission-oriented design make?",
      "back": "It puts resources around a product or business aim, which helps speed and accountability. The cost is possible duplication of scarce expertise.",
      "difficulty": "medium"
    },
    {
      "cardId": "c03",
      "sourceAnchorIds": [
        "ch08.fact.5"
      ],
      "front": "Why are hybrid organizations common?",
      "back": "Both expertise and market accountability matter. A hybrid can preserve two needed strengths when either pure form would overpay for one of them.",
      "difficulty": "medium"
    },
    {
      "cardId": "c04",
      "sourceAnchorIds": [
        "ch08.fact.8"
      ],
      "front": "What must a hybrid interface state?",
      "back": "It must say who decides, who advises, and who executes. Without those lines, informal negotiation becomes friction and delay.",
      "difficulty": "medium"
    },
    {
      "cardId": "c05",
      "sourceAnchorIds": [
        "ch08.ex.hybridIntel",
        "ch08.fact.6",
        "ch08.fact.7"
      ],
      "front": "What does the Intel-style case teach?",
      "back": "Semiconductor manufacturing needs engineering depth and process discipline, yet customers and markets still experience the combined business result.",
      "difficulty": "hard"
    },
    {
      "cardId": "c06",
      "sourceAnchorIds": [
        "ch08.fact.9"
      ],
      "front": "How should you choose among organization forms?",
      "back": "Judge the tradeoff you need: speed, quality, cost, expertise, and accountability. No chart is best apart from the pressure it must serve.",
      "difficulty": "medium"
    }
  ],
  "implementationPlan": {
    "title": "Mark The Interface",
    "titleSourceAnchorIds": [
      "ch08.fact.8"
    ],
    "coreSkill": "Use the chart as a tradeoff map, not a status object. Mark the promise, then choose where depth lives, where speed matters, and where the interface must be explicit. The useful contrast is simple: agreement nods; commitment signs.",
    "coreSkillSourceAnchorIds": [
      "ch08.fact.1",
      "ch08.fact.2",
      "ch08.fact.5",
      "ch08.fact.8",
      "ch08.fact.9"
    ],
    "ifThenPlans": [
      {
        "sourceAnchorIds": [
          "ch08.fact.3",
          "ch08.fact.7"
        ],
        "context": "When a function gives a local yes",
        "plan": "If a function gives a local yes, then mark the business answer it must join."
      },
      {
        "sourceAnchorIds": [
          "ch08.fact.4"
        ],
        "context": "When a product unit asks for its own specialist capacity",
        "plan": "If a product unit asks to rebuild a specialty, then mark the shared standard it would leave."
      },
      {
        "sourceAnchorIds": [
          "ch08.fact.8"
        ],
        "context": "When hybrid roles feel polite but slow",
        "plan": "If the path is polite and slow, then mark who decides, advises, and executes."
      }
    ],
    "twentyFourHourChallenge": "Before your next status pass, mark one cross-specialty promise and write who decides, advises, and executes in 10 minutes.",
    "twentyFourHourChallengeSourceAnchorIds": [
      "ch08.fact.8",
      "ch08.fact.9"
    ],
    "weeklyPractice": "At the next cross-specialty status pass, measure one number: how many promises had named decision, advice, and execution lines before action moved.",
    "weeklyPracticeSourceAnchorIds": [
      "ch08.fact.5",
      "ch08.fact.8",
      "ch08.fact.9"
    ]
  },
  "memorableLines": [
    {
      "text": "Every vague interface spends response time before anyone admits it.",
      "location": "breakdown.deepRead",
      "why": "It names the concrete price of leaving hybrid lines informal.",
      "sourceAnchorIds": [
        "ch08.fact.8"
      ]
    },
    {
      "text": "Which promise is the chart making easier, and which promise is it making slower?",
      "location": "breakdown.deepRead",
      "why": "It turns organization design into a tradeoff question instead of a chart preference.",
      "sourceAnchorIds": [
        "ch08.fact.9"
      ]
    },
    {
      "text": "Make the interface explicit.",
      "location": "breakdown.fastRead",
      "why": "It gives the reader the shortest usable command for hybrid work.",
      "sourceAnchorIds": [
        "ch08.fact.8"
      ]
    }
  ],
