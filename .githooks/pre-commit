#!/usr/bin/env bash
# Pre-commit guards (shared with CI):
#   1. block committed build artifacts / hardcoded secrets
#      (scripts/ci/scan-secrets-and-artifacts.sh)
#   2. block design-system / token drift
#      (scripts/ci/scan-style-drift.mjs — Tailwind v4 syntax, undeclared tokens,
#       raw colors, literal catalog counts)
# Installed automatically by package.json "prepare" (git config core.hooksPath .githooks).
# Emergency bypass (local only): git commit --no-verify
set -u
ROOT="$(git rev-parse --show-toplevel)"
"$ROOT/scripts/ci/scan-secrets-and-artifacts.sh" --staged || exit 1
exec node "$ROOT/scripts/ci/scan-style-drift.mjs" --staged
